      <CodeComponent name="initCode" plugin="None">
        <Param val="initInfo = {&amp;#10;    &quot;runNum&quot;: [&quot;1&quot;, &quot;2&quot;, &quot;3&quot;, &quot;4&quot;],&amp;#10;    &quot;seed&quot;: &quot;2608191524&quot;&amp;#10;}&amp;#10;&amp;#10;dlg = gui.DlgFromDict(&amp;#10;    dictionary=initInfo,&amp;#10;    title=&quot;Select Run and Seed&quot;&amp;#10;)&amp;#10;&amp;#10;if not dlg.OK:&amp;#10;    core.quit()&amp;#10;&amp;#10;runNum = initInfo[&quot;runNum&quot;]&amp;#10;seed = initInfo[&quot;seed&quot;]&amp;#10;&amp;#10;if isinstance(runNum, (list, tuple)):&amp;#10;    runNum = runNum[0]&amp;#10;&amp;#10;if isinstance(seed, (list, tuple)):&amp;#10;    seed = seed[0]&amp;#10;&amp;#10;runNum = str(runNum)&amp;#10;seed = str(seed)&amp;#10;&amp;#10;conditionsFile = os.path.join(&amp;#10;    f&quot;output/{seed}&quot;,&amp;#10;    f&quot;trialSequence{seed}.csv&quot;&amp;#10;)&amp;#10;&amp;#10;print(&quot;Selected run:&quot;, runNum)&amp;#10;print(&quot;Selected seed:&quot;, seed)&amp;#10;print(&quot;Conditions file:&quot;, conditionsFile)" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if runNum == &quot;1&quot;:&amp;#10;    useRows = &quot;0:10&quot;&amp;#10;elif runNum == &quot;2&quot;:&amp;#10;    useRows = &quot;10:20&quot;&amp;#10;elif runNum == &quot;3&quot;:&amp;#10;    useRows = &quot;20:30&quot;&amp;#10;elif runNum == &quot;4&quot;:&amp;#10;    useRows = &quot;30:40&quot;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
